
&НаСервере
Функция ПолучитьСуммуДокумента()
	
	 ОбщаяСумма=0;
	 
	 Для Каждого СтрокаТовары Из Объект.Товары Цикл
		 ОбщаяСумма = ОбщаяСумма + СтрокаТовары.Сумма;
	 КонецЦикла;
	 
	 Возврат ОбщаяСумма;
	 
 КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СуммаДокумента = ПолучитьСуммуДокумента();
	Сообщить("Сумма документа: " + СуммаДокумента);

КонецПроцедуры


&НаКлиенте
Процедура ПроверитьДокумент(Отказ)
	
	// Проверяем, что выбран контрагент
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Сообщить ("Ошибка: выберите контрагента!");
		Отказ = Истина;
	КонецЕсли;
	
	//Проверяем, что в документе есть хотя бы одна строка
	Если Объект.Товары.Количество() = 0 Тогда
		Сообщить("Ошибка: добавьте хотя бы одну строку в табличную часть!");
		Отказ=Истина;
	КонецЕсли
КонецПроцедуры

 &НаКлиенте
 Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	 
	  ПроверитьДокумент(Отказ);
	  
  КонецПроцедуры

&НаКлиенте
  Процедура РассчитатьИтого(Команда)
	  // Вставить содержимое обработчика.
	  
	  ОбщаяСумма = 0;
	  
	  //Пересчитываем сумму каждой строки и копим общий итог
	  Для Каждого СтрокаТовары Из Объект.Товары Цикл
		  СтрокаТовары.Сумма = СтрокаТовары.Количество * СтрокаТовары.Цена;
		  ОбщаяСумма = ОбщаяСумма + СтрокаТовары.Сумма;
	  КонецЦикла;
	  
	  Сообщить("Итого по документу: " + ОбщаяСумма);
  КонецПроцедуры
